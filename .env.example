# SEO Intel Configuration
# Run `node cli.js setup` to configure interactively

# ── License (Pro features) ───────────────────────────────────────────────
# Get your key at https://ukkometa.fi/en/seo-intel/
# SEO_INTEL_LICENSE=SI-xxxx-xxxx-xxxx-xxxx

# ── Analysis Model (cloud, pick one) ──────────────────────────────────────
# These keys are used for the analysis itself (analyze, keywords, scan,
# blog-draft, loop): each provider is called over its own API from
# lib/providers.js. Earlier releases only pinged them from the setup wizard
# and sent the analysis to the Gemini CLI or the Agent Harness regardless.
#
# Gemini: Best value — 1M context, cheapest (~$0.01-0.05/analysis)
GEMINI_API_KEY=
# GEMINI_TIMEOUT_MS=120000

# Claude: Best quality — nuanced strategic reasoning (~$0.10-0.30/analysis)
# ANTHROPIC_API_KEY=
# Anthropic runs a declined request on a server-side fallback model unless
# this is set; set it to keep every answer on the exact model named.
# ANTHROPIC_FALLBACKS=off

# OpenAI: Solid all-around (~$0.05-0.15/analysis)
# OPENAI_API_KEY=

# DeepSeek: Budget cloud option (~$0.02-0.08/analysis)
# DEEPSEEK_API_KEY=

# Which provider and model answer when a command is not told (--provider /
# --model). The setup wizard writes both. A --model on the command line that
# names another provider (--model claude, --model gpt-4o-mini) still wins over
# ANALYSIS_PROVIDER for that run; --provider always wins. Without either, the
# first key set above wins, in the order anthropic, openai, gemini, deepseek;
# then the Agent Harness gateway if its token is found; then the Gemini CLI.
# ANALYSIS_PROVIDER=anthropic          # anthropic | openai | gemini | deepseek | ollama | harness | gemini-cli
# ANALYSIS_MODEL=claude-opus-5         # a full model id, or an alias (claude, gpt, gemini, deepseek, ollama)
#
# How long one model request may take, in milliseconds, for every provider
# (analyze, keywords, scan, blog-draft, loop). Raise it for a large local
# model on modest hardware. Unset: GEMINI_TIMEOUT_MS / OPENCLAW_TIMEOUT_MS for
# the Gemini and Agent Harness transports they always governed, else 120000.
# ANALYSIS_TIMEOUT_MS=120000

# Local analysis with Ollama (ANALYSIS_PROVIDER=ollama): the tag to use and
# the context window the judgments get (they are small; 16K is plenty).
# OLLAMA_ANALYSIS_MODEL=gemma4:26b
# OLLAMA_ANALYSIS_CTX=16384

# Agent Harness gateway (ANALYSIS_PROVIDER=harness): the agent id, or
# "default" for the gateway's own. The token comes from OPENCLAW_TOKEN or
# ~/.openclaw/openclaw.json.
# OPENCLAW_ANALYSIS_MODEL=default
# OPENCLAW_TIMEOUT_MS=120000

# ── OAuth (Google Search Console, Analytics) ─────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Type: OAuth 2.0 Client ID → Desktop app
# Then run `seo-intel auth google`. Once connected, the tokens are stored
# owner-only under ~/.seo-intel/tokens/ — never in this file or the package dir.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GSC_ACCESS_TOKEN is only an override for CI or a hand-issued short-lived
# token: when set, `gsc-fetch` and `gsc-platform --api` use it instead of the
# connected account.
# GSC_ACCESS_TOKEN=

# ── Extraction Model (local Ollama) ───────────────────────────────────────
# Recommended: gemma4:e4b (default), gemma4:e2b (budget), gemma4:26b (quality)
# Also supported: qwen3.5:9b, qwen3.5:4b, qwen3.5:27b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_CTX=8192
OLLAMA_TIMEOUT_MS=60000   # 60s default — increase to 120000 on slow hardware (BUG-008)

# Fallback Ollama host (optional — for LAN setups)
# OLLAMA_FALLBACK_URL=http://192.168.0.xxx:11434
# OLLAMA_FALLBACK_MODEL=qwen3:4b

# ── Crawler Settings ──────────────────────────────────────────────────────
CRAWL_DELAY_MS=1500
CRAWL_MAX_PAGES=50
CRAWL_TIMEOUT_MS=15000
