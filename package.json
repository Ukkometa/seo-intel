{
  "name": "seo-intel",
  "version": "1.7.0",
  "description": "Local Ahrefs-style SEO competitor intelligence. Crawl → SQLite → cloud analysis.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Ukkometa <anssi@ukkometa.fi> (https://ukkometa.fi)",
  "homepage": "https://ukkometa.fi/en/seo-intel/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ukkometa/seo-intel.git"
  },
  "keywords": [
    "seo",
    "competitor-analysis",
    "web-crawler",
    "content-intelligence",
    "search-console",
    "ollama",
    "local-first"
  ],
  "bin": {
    "seo-intel": "cli.js",
    "seo-intel-mcp": "mcp/server.js"
  },
  "exports": {
    ".": "./cli.js",
    "./agent-harness": "./agent-harness.js",
    "./froggo": "./agent-harness.js",
    "./aeo": "./analyses/aeo/index.js",
    "./aeo/scorer": "./analyses/aeo/scorer.js",
    "./entity-audit": "./analyses/entity/index.js",
    "./triangulation": "./analyses/triangulation/index.js",
    "./gsc-platform": "./analyses/gsc-platform/index.js",
    "./geo": "./analyses/geo/index.js",
    "./schema-audit": "./analyses/schema-audit/index.js",
    "./page-contract": "./analyses/page-contract/index.js",
    "./gsc-import": "./lib/gsc-import.js",
    "./brand": "./lib/brand.js",
    "./backlinks": "./analyses/backlinks/index.js",
    "./backlink-import": "./lib/backlink-import.js",
    "./gap-intel": "./analyses/gap-intel/index.js",
    "./blog-draft": "./analyses/blog-draft/index.js",
    "./crawler": "./crawler/index.js",
    "./db": "./db/db.js",
    "./exports/technical": "./exports/technical.js",
    "./exports/competitive": "./exports/competitive.js",
    "./exports/suggestive": "./exports/suggestive.js",
    "./exports/queries": "./exports/queries.js",
    "./templates": "./analyses/templates/index.js",
    "./dashboard": "./reports/generate-html.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "files": [
    "cli.js",
    "agent-harness.js",
    "server.js",
    "scheduler.js",
    "seo-audit.js",
    "lib/",
    "setup/checks.js",
    "setup/config-builder.js",
    "setup/engine.js",
    "setup/installers.js",
    "setup/models.js",
    "setup/openclaw-bridge.js",
    "setup/validator.js",
    "setup/web-routes.js",
    "setup/wizard.html",
    "lib/hermes-plugin.js",
    "config/setup-wizard.js",
    "config/example.json",
    "crawler/",
    "db/db.js",
    "db/schema.sql",
    "analyses/",
    "analysis/",
    "extractor/",
    "exports/",
    "hermes/",
    "mcp/",
    "reports/generate-html.js",
    "reports/generate-site-graph.js",
    "reports/gsc-loader.js",
    ".env.example",
    "LICENSE",
    "README.md",
    "seo-intel.png",
    "Start SEO Intel.command",
    "Setup SEO Intel.command",
    "Start SEO Intel.bat",
    "start-seo-intel.sh",
    "CHANGELOG.md"
  ],
  "scripts": {
    "crawl": "node cli.js crawl",
    "analyze": "node cli.js analyze",
    "report": "node cli.js report",
    "setup": "node cli.js setup",
    "serve": "node cli.js serve",
    "check": "node scripts/check-layers.js",
    "check:fix": "node scripts/check-layers.js --fix",
    "check:json": "node scripts/check-layers.js --json",
    "test:modern-seo": "node test/modern-seo.test.js",
    "test:ledger": "node test/ledger.test.js",
    "test:page-contract": "node test/page-contract.test.js",
    "test:backlinks": "node test/backlinks.test.js",
    "test": "node test/modern-seo.test.js && node test/ledger.test.js && node test/page-contract.test.js && node test/backlinks.test.js",
    "postinstall": "echo '\\n  SEO Intel installed.\\n  Run: seo-intel setup\\n  Or: seo-intel serve (opens dashboard)\\n'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.5",
    "node-fetch": "^3.3.2",
    "playwright": "^1.43.0",
    "turndown": "^7.2.2"
  }
}
